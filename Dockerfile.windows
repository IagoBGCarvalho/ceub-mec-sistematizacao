# NÃO USAR ESTE ARQUIVO!!!!

# Dockerfile.windows — versão para WINDOWS CONTAINERS

# ATENÇÃO — leia antes de usar:
#
# Isto NÃO é o Dockerfile usado numa máquina Windows normal. 
# É um container que precisa de um HOST com kernel Windows rodando o modo
# "Windows containers" do Docker, não o modo padrão do Docker Desktop que usa Linux. Ele:
#   - NÃO roda no Linux.
#   - Precisaria de uma máquina Windows com o recurso "Containers" habilitado
#     e o Docker Desktop configurado explicitamente em "Windows containers
#     mode".
#   - Gera imagens ORDENS DE GRANDEZA maiores (as imagens base
#     windowsservercore costumam passar de 4-5 GB, contra ~150 MB da
#     python:3.14-slim baseada em Debian).
FROM python:3.14-windowsservercore-ltsc2022

# Sintaxe de caminho no estilo Windows
WORKDIR C:\\app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ .\\src\\
COPY data/ .\\data\\

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "src/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
